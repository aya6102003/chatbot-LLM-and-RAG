ﺎٰڈﺎ وﻃﺮʈﻘﺔ اﻟتܦجﻴﻞ )ﺻﻮȖﻲ/ﻣﺮئﻲ/ﺗﺪوʈﻦ‏\n \n‏- اﻻﺳتﺌﺬان ࢭʏ اﻟتܦجﻴﻞ وﺗﺄﻛﻴﺪ اﻟﺴﺮʈﺔ‏\n. \n‏- اﻟﺘﻔﺮيﻎ اﻟﻜﺘﺎȌﻲ اﻟɢﺎﻣﻞ‏\n. . \n‏- ﺑﺮﻧﺎﻣﺞ اﻟﺘﺤﻠﻴﻞ اﻟﻨﻮڤʏ اﳌﺴﺘﺨﺪم‏\n  \n‏( NVivo /  )ﻳﺪوي‏\n.  \n \n \nR \n‏ اﻟﻨﺘﺎﺋﺞ ‏\n‏Results  —   ﻣﺎ اﻟﺬي ﻛﺸﻔﺖ ﻋﻨﮫ اﳌﻘﺎﺑﻼت؟‏\n \n \n‏ Ȗﻌﺮ ض ﻧﺘﺎﺋﺞ اﳌﻘﺎﺑﻼت ﺑﺄﺳﻠﻮب ﻣﻮﺿﻮﻋﺎȖﻲ ﻣﻨﻈ ﻢ، ﻻ ﺑﺎﻟتﺴﻠﺴﻞ اﳌﻘﺎﺑﻠﺔ ﺗﻠﻮ اﻷﺧﺮى. ‏\n‏هﻴɢﻞ ﻋﺮض ﻧﺘﺎﺋﺞ اﳌﻘﺎﺑﻠﺔ : ‏\n‏ اﳌﺴﺘﻮى ﻃﺮʈﻘﺔ اﻟﻌﺮض ‏\n\n‏ ﻣﻨݤجﻴﺔ اﻷدوات اﻟﺒﺤﺜﻴﺔ وﻓﻖ ﻃﺮʈﻘﺔIMRAD —  ف؈ — اﻟﻌﻠﻮم اﻻﻗﺘﺼﺎدﻳﺔ واﻟﺘﺠﺎرʈﺔ وﻋﻠﻮم اﻟتﺴﻴ2 ف؅ﻣﺎﺳ‏\n \n— 8 — \n‏ اﳌﻮﺿﻮﻋﺎت اﻟﺮﺋيﺴﻴﺔ ‏\n‏ اﻷﻧﻤﺎط اﳌﺘﻜﺮرة ﻋ؄ف ﻏﺎﻟﺒﻴﺔ اﳌﻘﺎﺑﻼت ‏\n‏ اﻟﻔﺌﺎت اﻟﻔﺮﻋﻴﺔ ‏\n‏ ﺗﻔﺼﻴﻞ ɠﻞ ﻣﻮﺿﻮع رﺋيؠۜي ﺑﻤﻔﺎهﻴﻢ ﻓﺮﻋﻴﺔ ‏\n‏ اﻻﻗﺘﺒﺎﺳﺎت اﻟﺪاﻋﻤﺔ ‏\n‏ ...( Ȗﺴﻨﺪ ɠﻞ ﻣﻮﺿﻮع2، م1ﻣﻘﺘﻄﻔﺎت ﻧﺼﻴﺔ ﻣﺮﻣ ﺰة )م ‏\n‏ اﻟﺘﺒﺎﻳﻦ واﻻﺳﺘثﻨﺎءات ‏\n‏ آراء ﻣﻐﺎﻳﺮة ﺗﻮﻓﺮ ﻋﻤﻘﺎ  ﻧﻮﻋﻴﺎ وﺗﻤﻨﻊ اﻟﺘبﺴﻴﻂ ‏\n \n‏-  اﺳﺘﺨﺪم ﺟﺪول اﳌﻮﺿﻮﻋﺎت‏\n  \n‏ﻟﻌﺮض اﻟﺮﻣﻮز واﻟﺘﻌﺮʈﻔﺎت واﻟﺘﻜﺮارات‏\n.  \n‏- ﻗﺪم ﻣﺼﻔﻮﻓﺔ اﳌﻮاﺿﻴﻊ × اﳌﺒﺤﻮﺛ؈ن ﻹﻇهﺎر اﻻﻧتﺸﺎر‏\n . \n- \n‏ ﻻ ﺗﻔﺴﺮ، ﻓﻘﻂ اﻋﺮض ﻣﺎ ﻗﺎﻟﮫ اﳌﺒﺤﻮﺛﻮن‏\n . \nD \n‏ اﳌﻨﺎﻗﺸﺔ ‏\n‏Discussion  —  ﻣﺎذا Ȗﻌۚي ﻧﺘﺎﺋﺞ اﳌﻘﺎﺑﻼت وﻛﻴﻒ ﺗ ﻔﺴﺮ؟‏\n \n‏ ࡩʏ اﳌﻨݤج اݝخﺘﻠﻂ، ﺗﻘﻮم اﳌﻨﺎﻗﺸﺔ ﻋڴʄ رȋﻂ ﻧﺘﺎﺋﺞ اﳌﻘﺎﺑﻠﺔ ﺑنﺘﺎﺋﺞ اﻻﺳﺘبﻴﺎن وȋﺎﻷدﺑﻴﺎت اﻟﻨﻈﺮʈﺔ‏\n \n- \n‏ هﻞ Ȗﻌﺰ ز ﻧﺘﺎﺋﺞ اﳌﻘﺎﺑﻠﺔ ﻣﺎ ﻛﺸﻒ ﻋﻨﮫ اﻻﺳﺘبﻴﺎن أم ﺗتﻨﺎﻗﺾ ﻣﻌهﺎ؟‏\n \n‏- ﻛﻴﻒ ﺗﻔﺴ ﺮ اﳌﻮﺿﻮﻋﺎت ࢭʏ ﺿﻮء اﻟﻨﻈﺮʈﺎت اﻹدارʈﺔ أو اﻻﻗﺘﺼﺎدﻳﺔ؟‏\n \n- \n‏ ﻣﺎ اﻷȊﻌﺎد اﻟۘي ﻛﺸﻔْڈﺎ اﳌﻘﺎﺑﻠﺔ وﻟﻢ ʇﺴﺘﻄﻊ اﻻﺳﺘبﻴﺎن اﻹﻣﺴﺎك ٭ڈﺎ؟‏\n \n- \n‏ ﻣﺎ اﻟﺘﻮﺻﻴﺎت اﻟﻌﻤﻠﻴﺔ اﳌﺴﺘﻤﺪّ ة ﻣﻦ ﺧﻄﺎب اﳌﺒﺤﻮﺛ؈ن؟‏\n \n‏- ﻣﺎ ﺣﺪود اﻟﺘﻌﻤﻴﻢ ࢭʏ ﻇﻞ اﻟﻌﻴّﻨﺔ اﻟﺼﻐ؈فة واﻟﺴﻴﺎق اݝحﺪد؟‏\n \n‏ ﻣﺴﺘﻮى اﳌﻨﺎﻗﺸﺔ‏\n‏  اﻹﺟﺮاء‏\n‏  اﻟهﺪف‏\n \n‏ ﺗﺜﻠﻴﺚ اﻟﺒﻴﺎﻧﺎت‏\n‏  ﻣﻘﺎرﻧﺔ ﻧﺘﺎﺋﺞ اﳌﻘﺎﺑﻠﺔ ﺑنﺘﺎﺋﺞ اﻻﺳﺘبﻴﺎن‏\n‏  Ȗﻌﺰʈﺰ اﳌﺼﺪاﻗﻴﺔ‏\n \n‏ اﻟﺘﺄﻃ؈ف اﻟﻨﻈﺮي‏\n \n‏رȋﻂ اﳌﻮﺿﻮﻋﺎت ﺑﻨﻈﺮʈﺎت ﻣﺤﺪدة‏\n‏  ف؈إﺛﺮاء اﻟﺘﻔﺴ‏\n \n‏ اﳌﻘﺎرﻧﺔ ﺑﺎﻟﺪراﺳﺎت اﻟﺴﺎﺑﻘﺔ‏\n‏  هﻞ اﳌﻮﺿﻮﻋﺎت اﻟﻜﻴﻔﻴﺔ ﺗﺘﻜﺮر ࢭʏ ﺳﻴﺎﻗﺎت أﺧﺮى؟‏\n‏  إﺛﺒﺎت اﻟﻘﺎﺑﻠﻴﺔ ﻟﻠﺘﺤﻮʈﻞ‏\n \n‏ اﻟﺘﻮﺻﻴﺎت‏\n‏  ﻣﺎ اﻹﺟﺮاءات اﻟۘي ﻳﻘ؅فﺣهﺎ اﳌﺒﺤﻮﺛﻮن؟‏\n‏  اﻟﺪﻻﻟﺔ اﻟﻌﻤﻠﻴﺔ‏\n \n \n \n\n‏ ﻣﻨݤجﻴﺔ اﻷدوات اﻟﺒﺤﺜﻴﺔ وﻓﻖ ﻃﺮʈﻘﺔIMRAD —  ف؈ — اﻟﻌﻠﻮم اﻻﻗﺘﺼﺎدﻳﺔ واﻟﺘﺠﺎرʈﺔ وﻋﻠﻮم اﻟتﺴﻴ2 ف؅ﻣﺎﺳ‏\n \n— 9 — \n‏ اﻷداة اﻟﺜﺎﻟﺜﺔ‏\n \n‏اﳌﻼﺣﻈﺔ‏\n \nI  →  M  →  R  →  D\n \n \nI \n‏ ﻣﻘﺪﻣﺔ‏\n \n‏Introduction  —  ﺗﻘﺪﻳﻢ اﳌﻼﺣﻈﺔ وﺗ؄فﻳﺮ ﺗﻮﻇﻴﻔهﺎ‏\n \n‏ اﻷﺳﺌﻠﺔ اﻹرﺷﺎدﻳﺔ : ‏\n- \n‏ ﳌﺎذا اﻟﺴﻠﻮك اﳌﻼﺣﻆ أهﻢ ﻣﻦ اﻟﺴﻠﻮك اﳌﺒﻠَ ﻎ ﻋﻨﮫ ࢭʏ دراﺳﺘﻚ؟‏\n \n- \n‏ ﻣﺎ اﻟﺬي ﻻ ʇﺴﺘﻄﻴﻊ اﻻﺳﺘبﻴﺎن وﻻ اﳌﻘﺎﺑﻠﺔ اﻟﺘﻘﺎﻃﮫ ࢭʏ ﻇﺎهﺮﺗﻚ؟‏\n \n- \n‏ ﻣﺎ اﻹﻃﺎر اﳌﻔﺎهﻴ׿ي اﻟﺬي ʇﺴﺘﺪڤʏ اﳌﻼﺣﻈﺔ اﳌﺒﺎﺷﺮة؟‏\n \n \n‏ﻣﺎ ﻳﻜﺘﺐ‏\n \n‏ﻋﻨﺼﺮ I ‏\n‏ﻇﺎهﺮة ﺳﻠﻮﻛﻴﺔ ﻻ ﻳﻤﻜﻦ ﻗﻴﺎﺳهﺎ ﺑﺎﻟﺘﺼﺮʈﺢ ﻓﻘﻂ‏\n‏  ﻃﺒﻴﻌﺔ اﻟﻈﺎهﺮة‏\n \n‏ ﺗ؄فﻳﺮ+  ﻣﻨﻈّﻤﺔ / ﻏ؈ف ﻣﻨﻈّﻤﺔ+ ﻣﺸﺎرﻛﺔ / دون ﻣﺸﺎرﻛﺔ ‏\n‏ ﻧﻮع اﳌﻼﺣﻈﺔ‏\n \n‏ وﺻﻒ ﻣﻮﻗﻊ اﳌﻼﺣﻈﺔ وزﻣﺎٰڈﺎ‏\n \n‏اﻟﺴﻴﺎق اﳌﻴﺪاɲﻲ‏\n \n‏ ﻣﺮاﺟﻊ اﻋﺘﻤﺪت اﳌﻼﺣﻈﺔ ࢭʏ ﻧﻔﺲ اﳌﻴﺪان‏\n‏  اﻟﺪراﺳﺎت اﻟﺴﺎﺑﻘﺔ‏\n \n \nM\n \n‏ اﳌﻨݤجﻴﺔ‏\n \n‏Methodology  —  ﻛﻴﻒ أﻋﺪ دﻟﻴﻞ اﳌﻼﺣﻈﺔ وﻛﻴﻒ ﻃﺒ ﻘﺖ؟‏\n \n \n1\n‏ :. ﺑﻨﺎء دﻟﻴﻞ اﳌﻼﺣﻈﺔ‏\n \n‏- ﺗﺤﺪﻳﺪ اﻷȊﻌﺎد واﳌﺆﺷﺮات اﳌﺮاد ﻣﺸﺎهﺪٮڈﺎ اﻧﻄﻼﻗﺎً ﻣﻦ اﳌﺘﻐ؈فات‏\n . \n‏( اﺧﺘﻴﺎر أداة اﻟتܦجﻴﻞ: ﻗﺎﺋﻤﺔ ﺗﺪﻗﻴﻖChecklist) / ﻣﻘﻴﺎس ﺗﻘﺪﻳﺮ / ﻣﻼﺣﻈﺎت ﺣﺮّة. ‏\n‏- ﺗﺤﻜﻴﻢ اﻟﺪﻟﻴﻞ ﻣﻦ ﻗِﺒﻞ ﺧﺒ؈فﻳﻦ ﻋڴʄ اﻷﻗﻞ‏\n . \n\n‏ ﻣﻨݤجﻴﺔ اﻷدوات اﻟﺒﺤﺜﻴﺔ وﻓﻖ ﻃﺮʈﻘﺔIMRAD —  ف؈ — اﻟﻌﻠﻮم اﻻﻗﺘﺼﺎدﻳﺔ واﻟﺘﺠﺎرʈﺔ وﻋﻠﻮم اﻟتﺴﻴ2 ف؅ﻣﺎﺳ‏\n \n— 10 — \n2.\n‏ اﻟﺪﺧﻮل اﳌﻴﺪاɲﻲ واﻟﺘﻨﻔﻴﺬ ‏\n‏ اﻟﺘﻔﺼﻴﻞ‏\n‏  اﻹﺟﺮاء‏\n \n‏ اݍحﺼﻮل ﻋڴʄ إذن رﺳ׿ي ﻣﻦ اﳌﺆﺳﺴﺔ / اݝجﻤﻮﻋﺔ‏\n‏  اﻹذن واﻟﻮﺻﻮل‏\n \n‏'ﺟﻠﺴﺎت أوﻟﻴﺔ ﻟﺘﻘﻠﻴﻞ 'أﺛﺮ اﳌﺮاﻗﺐ‏\n‏  ﻓ؅فة اﻟﺘﻌﺎرف‏\n \n‏  اﻟﺘﻮﻗﻴﺖ+  ﻣﺪة ɠﻞ ﺟﻠﺴﺔ+ ﻋﺪد اݍجﻠﺴﺎت‏\n‏  ﺟﺪول اݍجﻠﺴﺎت‏\n \n‏  ﺗﺪوʈﻦ ﺣﻘڴʏ ﻓﻮري+ ﻣﺒﺎﺷﺮ / Ȗܦجﻴﻞ ﻣﺮئﻲ‏\n‏  أﺳﻠﻮب اﻟتܦجﻴﻞ‏\n \n‏ إذا Ȗﻌﺪد اﳌﻼﺣﻈﻮن‏\n‏  اﻟﺜﺒﺎت ﺑ؈ن اﳌﻼﺣﻈ؈ن‏\n \n \nR \n‏ اﻟﻨﺘﺎﺋﺞ ‏\n‏Results  —   ﻣﺎ اﻟﺬي رﺻﺪﺗﮫ اﳌﻼﺣﻈﺎت اﳌﻴﺪاﻧﻴﺔ؟‏\n \n \n‏  Ȗﻌﺮ ض ﻧﺘﺎﺋﺞ اﳌﻼﺣﻈﺔ ﺑﻤﺰʈﺞ ﻣﻦ اﻟﻮﺻﻒ اﻟﻜﺜﻴﻒ ‏\n‏(Thick Description)  واﻟ؅فﻣ؈ق اﳌﻮﺿﻮﻋﺎȖﻲ‏\n \n‏أﺳﺎﻟﻴﺐ ﻋﺮض ﻧﺘﺎﺋﺞ اﳌﻼﺣﻈﺔ : ‏\n‏ اﻻﺳﺘﺨﺪام‏\n‏  اﻷﺳﻠﻮب‏\n \n‏ﻋﺪد ﻣﺮات ﻇهﻮر ɠﻞ ﻣﺆﺷﺮ ﻋ؄ف اݍجﻠﺴﺎت‏\n‏  ﺟﺪول ﺗﻜﺮار اﳌﺆﺷﺮات‏\n \n‏ ﺳﺮد ﻣﻮﺿﻮﻋﺎȖﻲ ﻣﻔﺼّﻞ ﻟﻸﺣﺪاث واﻟﺴﻠﻮﻛﻴﺎت‏\n‏  اﻟﻮﺻﻒ اﻟﻜﺜﻴﻒ‏\n \n‏ﺗﺤﻮّل اﻟﺴﻠﻮﻛﻴﺎت ﻋ؄ف ﺟﻠﺴﺎت اﳌﻼﺣﻈﺔ‏\n‏  ﺟﺪول اﳌﻘﺎرﻧﺔ اﻟﺰﻣﻨﻴﺔ‏\n \n‏ ف؈ﻣﻘﺘﻄﻔﺎت ﻣﻦ دﻓﺎﺗﺮ اﳌﻼﺣﻈﺔ ﻟﺪﻋﻢ اﻟﺘﻔﺴ‏\n‏  اﻻﻗﺘﺒﺎﺳﺎت اݍحﻘﻠﻴﺔ‏\n \n \n‏- رﺗﺐ اﻟﻨﺘﺎﺋﺞ ﺣﺴﺐ أȊﻌﺎد اﻟﺪﻟﻴﻞ ﻻ ﺣﺴﺐ Ȗﺴﻠﺴﻞ اݍجﻠﺴﺎت‏\n . \n‏- أﺷﺮ إڲʄ ﺗﻮاﺗﺮ اﻷﻧﻤﺎط ودرﺟﺔ اȖﺴﺎﻗهﺎ ﻋ؄ف اݍجﻠﺴﺎت‏\n. \n‏- وﺛﻖ اﻻﺳﺘثﻨﺎءات واﻟﺴﻠﻮﻛﻴﺎت اﳌﺘﻀﺎرȋﺔ ﺑﻨﻔﺲ اﻷهﻤﻴﺔ‏\n.  \n \n \n \n \n\n‏ ﻣﻨݤجﻴ