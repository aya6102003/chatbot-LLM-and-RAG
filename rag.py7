    # Arabic triggers
    r"\b(كلية|قسم|شعبة|تخصص|ليسانس|ماستر|دكتوراه)\s*\w*\b",
    # English triggers
    r"\b(faculty|department|program|specialization|bachelor|master|phd|doctorate)\s*(of\s+)?\w*\b",
    # Direct department/program names
    r"\b(informatique|informatique\s*industrielle|isi|g[ée]nie\s*logiciel|gl|rsd|r[ée]seaux)\b",
    r"\b(math[ée]matiques|math[ée]matiques\s*et\s*informatique|mi|maths?)\b",
