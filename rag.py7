    r"\b(sciences?\s*(de\s*la\s*)?(mati[èe]re|vie|nature|technologie|commerciales?|[ée]conomiques?)|sm|sv|st|sn|snv|svt)\b",
]

_STOPWORDS: Set[str] = {
