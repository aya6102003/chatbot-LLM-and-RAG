# ── Auto-detect keywords for academic entities ─
_ACADEMIC_ENTITY_TRIGGERS = [
    # French triggers
    r"\b(facult[ée]\s*(des?\s*)?(sciences?|m[ée]decine|technologie|lettres?|droit|economie|g[ée]nie|informatique)?)\b",
    r"\b(d[ée]partement\s*(d['\s]?)?(informatique|math[ée]matiques|physique|chimie|biologie|g[ée]nie|mi|sm|st|svt|snv)?)\b",
    r"\b(fili[èe]re\s*(d['\s]?)?\w+)\b",
    r"\b(sp[ée]cialit[ée]\s*\w*)\b",
